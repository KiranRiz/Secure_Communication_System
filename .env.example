# Copy to .env and fill in real values. Never commit .env.

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/Secure_Communication?retryWrites=true&w=majority
MONGODB_DB=Secure_Communication

SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Email / OTP (set EMAIL_DEV_MODE=false in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your@gmail.com
EMAIL_DEV_MODE=true

RATE_LIMIT_AUTH=5 per minute
FLASK_DEBUG=true
HOST=0.0.0.0
PORT=5000
